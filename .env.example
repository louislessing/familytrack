# FamilyTrack Environment Configuration
# Copy this file to .env and update the values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://familytrack:password@localhost:5432/familytrack

# ============================================
# AUTHENTICATION
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this-to-random-32-chars-min
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# REDIS (OPTIONAL - for caching and sessions)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ============================================
# FILE STORAGE (OPTIONAL - for documents)
# ============================================
# S3-compatible storage for documents
S3_BUCKET=familytrack-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=  # Optional: for S3-compatible services like Wasabi, Backblaze

# Local file storage (if not using S3)
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=FamilyTrack
VITE_APP_VERSION=1.0.0

# ============================================
# EMAIL CONFIGURATION (OPTIONAL)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@familytrack.app

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE=./logs/app.log

# ============================================
# SECURITY
# ============================================
RATE_LIMIT_MAX=100  # Max requests per window
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
BCRYPT_ROUNDS=10

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_CHILDREN_PROFILES=true
ENABLE_CALENDAR=true
ENABLE_HANDOVERS=true
ENABLE_EXPENSES=true
ENABLE_COMMUNICATIONS=true
ENABLE_DOCUMENTS=true
ENABLE_GUARDIANS=true
ENABLE_LEGAL_RECORDS=true
ENABLE_CLOTHING_INVENTORY=true
ENABLE_LAC_REVIEWS=true

# ============================================
# ANALYTICS (OPTIONAL)
# ============================================
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# ============================================
# DEVELOPMENT TOOLS
# ============================================
ENABLE_API_DOCS=true  # Swagger/OpenAPI docs
ENABLE_DEBUG=false
