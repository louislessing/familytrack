    "@tanstack/router-devtools": "^1.93.0",
    "@tanstack/router-plugin": "^1.92.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.6",
